{
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"],

  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],

    /* Emitted as ESM consumed by Node's resolver, so relative imports carry
       explicit .js extensions and NodeNext resolution enforces that. */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,

    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
