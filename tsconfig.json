{
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"],

  "compilerOptions": {
    "target": "ES2022",

    /* DOM is here for AbortController, AbortSignal and DOMException, which
       `promise` and `abort` are built on. Despite the lib's name those are
       WHATWG platform standards rather than document APIs, present in
       browsers, Node 20+, Deno and Bun alike, so depending on them keeps the
       library runtime-agnostic where @types/node would assert Node.
       They reach the emitted .d.ts, so consumers need DOM or @types/node
       in their own lib as well — see the README.
       The cost, paid across all of src: DOM also declares ambient globals
       like `name`, `status`, `origin`, `self` and `close`, so a typo that
       would otherwise be an unresolved identifier can quietly resolve to one
       of them instead. Worth knowing when a reference in this library
       typechecks and you cannot see where it comes from. */
    "lib": ["ES2022", "DOM"],

    /* Emitted as ESM consumed by Node's resolver, so relative imports carry
       explicit .js extensions and NodeNext resolution enforces that. */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,

    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
