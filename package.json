{
  "name": "@lhellemons/ground-types",
  "version": "0.3.0",
  "description": "Tactical DDD building blocks and the functional primitives they stand on.",
  "license": "MIT",
  "author": "Laurens Hellemons",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhellemons/ground-types.git"
  },
  "keywords": [
    "ddd",
    "value-object",
    "entity",
    "branded-types",
    "maybe",
    "result",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./abort": {
      "types": "./dist/abort/index.d.ts",
      "default": "./dist/abort/index.js"
    },
    "./brand": {
      "types": "./dist/brand/index.d.ts",
      "default": "./dist/brand/index.js"
    },
    "./call": {
      "types": "./dist/call/index.d.ts",
      "default": "./dist/call/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./fn": {
      "types": "./dist/fn/index.d.ts",
      "default": "./dist/fn/index.js"
    },
    "./intern-registry": {
      "types": "./dist/intern-registry/index.d.ts",
      "default": "./dist/intern-registry/index.js"
    },
    "./maybe": {
      "types": "./dist/maybe/index.d.ts",
      "default": "./dist/maybe/index.js"
    },
    "./promise": {
      "types": "./dist/promise/index.d.ts",
      "default": "./dist/promise/index.js"
    },
    "./promise/fake": {
      "types": "./dist/promise/fake.d.ts",
      "default": "./dist/promise/fake.js"
    },
    "./result": {
      "types": "./dist/result/index.d.ts",
      "default": "./dist/result/index.js"
    },
    "./value-object": {
      "types": "./dist/value-object/index.d.ts",
      "default": "./dist/value-object/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "prepare": "pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "fix": "prettier --write .",
    "assert:exports": "node scripts/assert-exports-resolve.mjs",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "prettier": "^3.8.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@10.8.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
